# Dockerfile.frontend
# Multi-stage build for frontend

# ============================================================
# Stage 1: Build
# ============================================================

# Node.js 22 is required by the current Vue/I18n dependencies.
FROM node:22-slim AS builder

WORKDIR /app

# ============================================================
# Copy package files first
# ============================================================

COPY frontend/package*.json ./

# ============================================================
# Install dependencies
# ============================================================

# Install both dependencies and devDependencies because
# vue-tsc and vite are required during the build.
#
# --include=dev ensures development dependencies are available.
# --no-audit and --no-fund reduce unnecessary network requests.
RUN npm ci --include=dev --no-audit --no-fund

# ============================================================
# Copy source code
# ============================================================

COPY frontend/ .

# ============================================================
# Vite environment variables
# ============================================================

# Vite replaces VITE_* variables during the build process.
# The default API path uses the reverse proxy configuration.
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=${VITE_API_URL}

# Backend URL used by frontend code where required.
ARG VITE_BACKEND_URL=""
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}

# ============================================================
# Build application
# ============================================================

RUN npm run build


# ============================================================
# Stage 2: Production
# ============================================================

FROM nginx:alpine

# Copy compiled frontend files.
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy Nginx configuration.
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Container listens on port 3000.
EXPOSE 3000

# Start Nginx.
CMD ["nginx", "-g", "daemon off;"]
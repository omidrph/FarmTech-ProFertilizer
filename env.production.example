# ============================================================
# .env  —  نسخه پروڈاکشن
# این فایل را کپی کنید به نام ".env" در ریشه پروژه (کنار docker-compose.yml)
# و مقادیر واقعی را جایگزین کنید. هرگز فایل .env واقعی را commit نکنید.
# ============================================================

# ============================================================
# دیتابیس PostgreSQL
# ============================================================
# 🔧 این مقادیر را از مقدار پیش‌فرض postgres/postgres تغییر دهید.
POSTGRES_USER=farmtech_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD
POSTGRES_DB=farmtech_db

# ============================================================
# امنیت
# ============================================================
# 🔧 اجباری است. اگر این مقدار خالی باشد یا برابر مقدار پیش‌فرض قدیمی
# ("your-super-secret-key-change-this-in-production") باشد، برنامه در
# حالت DEBUG=False (پروڈاکشن) اصلاً اجرا نخواهد شد.
#
# برای تولید یک مقدار امن، این دستور را روی سیستم خودتان اجرا کنید:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# نمونه (فقط برای نمایش فرمت - از همین مقدار استفاده نکنید، مقدار
# اختصاصی خودتان را تولید کنید):
SECRET_KEY=CHANGE_ME_GENERATE_YOUR_OWN_RANDOM_64_BYTE_KEY

# ============================================================
# محیط اجرا
# ============================================================
ENVIRONMENT=production
DEBUG=False

# ============================================================
# CORS  —  دامنه‌(های) واقعی فرانت‌اند شما
# ============================================================
# لیستی جدا شده با کاما، بدون اسلش انتهایی. اگر فرانت‌اند و بک‌اند را
# پشت همان nginx (پراکسی /api/) روی همان دامنه سرو می‌کنید، معمولاً به
# این مقدار نیازی نیست (چون درخواست‌ها same-origin هستند)، اما اگر
# فرانت‌اند از دامنه/ساب‌دامنه‌ی دیگری مستقیماً به API وصل می‌شود، حتماً
# اینجا اضافه کنید:
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================
# آدرس API که در بیلد فرانت‌اند جاسازی می‌شود (Build-time، نه Runtime)
# ============================================================
# اگر nginx.conf مسیر /api/ را به سرویس backend پروکسی می‌کند (پیش‌فرض
# پروژه)، بهترین و ساده‌ترین گزینه یک مسیر نسبی است تا نیازی به CORS
# هم نباشد:
VITE_API_URL=/api/v1
#
# اگر بک‌اند را روی دامنه/ساب‌دامنه‌ی جداگانه‌ای سرو می‌کنید (مثلاً
# api.yourdomain.com)، به‌جایش آدرس کامل بدهید و دامنه‌ی فرانت‌اند را
# هم حتماً در CORS_ORIGINS بالا اضافه کنید:
# VITE_API_URL=https://api.yourdomain.com/api/v1

# ============================================================
# پیامک (اختیاری - در صورت فعال بودن قابلیت‌های SMS)
# ============================================================
SMS_PROVIDER=kavenegar
SMS_API_KEY=
SMS_SENDER_NUMBER=
SMS_VERIFICATION_TEMPLATE=
SMS_RESET_PASSWORD_TEMPLATE=
SMS_2FA_TEMPLATE=

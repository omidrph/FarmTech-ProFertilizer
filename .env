# ============================================================
# FarmTech-ProFertilizer - Environment Variables
# نسخه امنیتی کامل - تاریخ: 2026-07-08
# ============================================================

# ============================================================
# تنظیمات دیتابیس PostgreSQL
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=farmtech_db
DATABASE_URL=postgresql://postgres:postgres@db:5432/farmtech_db

# ============================================================
# 🔐 تنظیمات SSL برای دیتابیس (غیرفعال برای توسعه)
# ============================================================
DB_SSL_MODE=disable
# DB_SSL_CA_CERT=/path/to/ca-cert.pem
# DB_SSL_CLIENT_CERT=/path/to/client-cert.pem
# DB_SSL_CLIENT_KEY=/path/to/client-key.pem

# ============================================================
# تنظیمات امنیت
# ============================================================
SECRET_KEY=your-super-secret-key-change-this-in-production

# ============================================================
# تنظیمات برنامه
# ============================================================
APP_NAME=FarmTech - ProFertilizer
APP_VERSION=0.1.0
DEBUG=True

# ============================================================
# ⚠️ CORS_ORIGINS حذف شده - از مقدار پیش‌فرض در config.py استفاده می‌شود
# ============================================================

# ============================================================
# تنظیمات فرانت‌اند
# ============================================================
VITE_API_URL=http://localhost:8000/api/v1

# ============================================================
# 🔐 تنظیمات امنیتی اضافی
# ============================================================
# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=300

# قفل حساب
MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Session
SESSION_EXPIRY_HOURS=24
SESSION_INACTIVITY_DAYS=30

# ============================================================
# 📱 تنظیمات پیامک (برای فعال‌سازی بعدی)
# ============================================================
SMS_PROVIDER=kavenegar
SMS_API_KEY=your-sms-api-key
SMS_SENDER_NUMBER=1000xxxx
SMS_VERIFICATION_TEMPLATE=verify-template-id
SMS_RESET_PASSWORD_TEMPLATE=reset-template-id
SMS_2FA_TEMPLATE=2fa-template-id

# ============================================================
# 🔐 تنظیمات 2FA
# ============================================================
TOTP_ISSUER=FarmTech
TOTP_PERIOD=30
TOTP_DIGITS=6